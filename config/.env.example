# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Scraping
APIFY_TOKEN=your_apify_token_here

# Reddit API (read-only) — register an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=news-reactive-content/0.1 by <your_reddit_username>

# Queue
REDIS_URL=redis://localhost:6379/0

# Database
# DATABASE_URL examples:
#   SQLite (current default, backward compat):
#     DATABASE_URL=sqlite:///data/app.db
#   Postgres (P2 target):
#     DATABASE_URL=postgresql+psycopg://aicg:aicg_local@localhost:5433/aicg
DATABASE_URL=sqlite:///data/app.db
