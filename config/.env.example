# Regenerated 2026-07-01 (audit AUD-H14) from the actual env reads in src/ + scripts/.
# Copy to config/.env and fill in. config/.env is gitignored and must never be committed.

# --- LLM: OpenRouter (src/providers/llm/openrouter_llm.py) ---
# Required by nearly every LLM seat in config/providers.yaml (provider: openrouter).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- LLM: Anthropic (read implicitly by the Anthropic SDK; dormant — zero seats
#     in config/providers.yaml use provider: anthropic today) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Scraping: Apify (Reddit actors) ---
# Read by: src/monitor/scraper.py, src/monitor/tools/reddit_search.py,
#          src/monitor/tools/subreddit_search.py, scripts/pitch_angles.py
APIFY_API_TOKEN=your_apify_token_here

# --- Context agent web search (src/monitor/tools/tavily_search.py) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Context agent page extraction (src/monitor/tools/firecrawl_extract.py) ---
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- Observability: Langfuse (read implicitly by the langfuse SDK) ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Database (src/database.py) ---
# POSTGRES ONLY (ADR 0006) — SQLite values are rejected at import with a RuntimeError.
# Local Docker default:
DATABASE_URL=postgresql+psycopg://aicg:aicg_local@localhost:5433/aicg

# --- Queue (RQ; worker wiring planned, no code reads this yet) ---
REDIS_URL=redis://localhost:6379/0

# --- Reddit API via praw — DORMANT (self-service keys gated since May 2026;
#     live Reddit sourcing goes through Apify instead). Kept for the parked
#     praw path only; leave blank unless reviving RedditScraper. ---
#REDDIT_CLIENT_ID=
#REDDIT_CLIENT_SECRET=
#REDDIT_USER_AGENT=news-reactive-content/0.1 by <your_reddit_username>
